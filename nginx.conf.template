server {
    listen 80;
    server_name _;

    client_max_body_size 200m;

    root /usr/share/nginx/html;
    index index.html;

    # 使用 Docker 内置 DNS 在请求时解析 OCR 上游，
    # 这样 OCR 容器未启动时 nginx 也能正常启动（OCR 接口返回 502）
    resolver 127.0.0.11 valid=10s ipv6=off;

    # OCR 健康检查
    location /health {
        set $ocr_upstream ${OCR_UPSTREAM};
        proxy_pass http://$ocr_upstream/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # 标注登录与数据 API（独立轻量服务，避免 OCR 容器 502）
    location /api/auth/ {
        proxy_pass http://${LABEL_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # 预识别批量任务：SSE 与大文件上传需要更长超时、关闭缓冲
    location /api/label/llm-jobs {
        proxy_pass http://${LABEL_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        chunked_transfer_encoding on;
        proxy_connect_timeout 30s;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location /api/label/ {
        proxy_pass http://${LABEL_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Qwen3-VL / Ollama API（/api/llm/api/chat -> ollama /api/chat）
    # 启动时 envsubst 写入固定 upstream（见 docker-entrypoint.sh 解析 host.docker.internal），
    # 避免变量 + resolver 127.0.0.11 无法解析 extra_hosts 中的 host.docker.internal
    location /api/llm/ {
        rewrite ^/api/llm/(.*)$ /$1 break;
        proxy_pass http://${LLM_UPSTREAM};
        proxy_http_version 1.1;
        # Ollama 会校验 Host/Origin；经 Docker 转发时用 LLM_PROXY_HOST（见 docker-entrypoint.sh）
        proxy_set_header Host ${LLM_PROXY_HOST};
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 关闭缓冲，流式 token 立刻转发给浏览器，避免长时间无响应被误判断连
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 30s;
        # VL 单页推理很慢；前端改为 stream 后仍保留较长超时兜底
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_socket_keepalive on;
    }

    # OCR API（/api/recognize/image 等）
    location /api/ {
        set $ocr_upstream ${OCR_UPSTREAM};
        proxy_pass http://$ocr_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
}
