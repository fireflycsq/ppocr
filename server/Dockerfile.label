FROM python:3.11-slim

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LABEL_DATA_DIR=/data/label_data

COPY requirements-label.txt .
RUN pip install --upgrade pip && pip install -r requirements-label.txt

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=10s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health')" || exit 1

CMD ["python", "-m", "uvicorn", "label_server:app", "--host", "0.0.0.0", "--port", "8001"]
