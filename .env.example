# === OCR 镜像 ===
OCR_IMAGE=myppocr:1.0
OCR_CONTAINER_NAME=myppocr
OCR_PORT=8000
OCR_PYTHON=python3

# === 宿主机路径（启动前建议: mkdir -p data/temp_uploads data/output） ===
OCR_SERVER_DIR=./server
OCR_MODELS_DIR=./paddleocr_models
OCR_TEMP_DIR=./data/temp_uploads
OCR_OUTPUT_DIR=./data/output

# === 容器内路径（与 docker-compose 挂载一致） ===
# server/        → /workspace
# paddleocr_models/ → /models
# data/temp_uploads → /data/temp_uploads
# data/output       → /data/output
OCR_CONTAINER_WORKDIR=/workspace

# === 前端 ===
FRONTEND_PORT=8080
OCR_UPSTREAM=myppocr:8000
OCR_EXTERNAL_NETWORK=ppocr-net

# === Ollama / Qwen3-VL ===
# Docker 部署默认走宿主机 11434；要求 Ollama 监听 0.0.0.0：
#   OLLAMA_HOST=0.0.0.0:11434 ollama serve
# 若 Ollama 也在容器中：LLM_UPSTREAM=<容器名>:11434 并接入同一 docker 网络
LLM_UPSTREAM=host.docker.internal:11434
# label-api 后台批量预识别直连 Ollama 的完整 URL（compose 默认拼成 http://$LLM_UPSTREAM）
# OLLAMA_BASE=http://host.docker.internal:11434

# === 单证标注用户与存储 ===
LABEL_DATA_DIR=./data/label_data
LABEL_API_IMAGE=ppocr-label-api:1.0
LABEL_API_CONTAINER_NAME=ppocr-label-api
JWT_SECRET=change-me-in-production
LABEL_DEFAULT_USER=admin
LABEL_DEFAULT_PASSWORD=admin123
LABEL_ALLOW_REGISTER=true
# 单个共享样例 PDF 最大体积（MB）
LABEL_EXAMPLE_MAX_MB=25
# 低清预判为非目标时的跳过阈值（越高越保守）
VITE_LLM_CLASSIFICATION_THRESHOLD=0.8
